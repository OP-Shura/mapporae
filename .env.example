# ==============================================================================
# Mapporae Environment Configuration
# ==============================================================================

# Supabase Authentication & Cloud Sync (Optional)
# Leave blank to run Mapporae in offline / localStorage mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# CRITICAL SECURITY RULE:
# Never add or expose the Supabase `service_role` key to client code or `.env.local`.
# Only the public anonymous key (NEXT_PUBLIC_SUPABASE_ANON_KEY) is permitted.
# ==============================================================================

# Server Geocoding (Optional)
# Public Nominatim requires a real, monitored contact User-Agent before live search is enabled.
# Example: Mapporae/1.0 (contact: support@your-domain.example)
NOMINATIM_USER_AGENT=
